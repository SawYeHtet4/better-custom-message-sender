APP=Yoma Fleet Better
VERSION=1.0.0
ENV=development

EMAIL_FROM=noreply@yomafleet.com

MAIL_TRANSPORT=smtp

MAIL_TRAP_HOST=smtp.mailtrap.io
MAIL_TRAP_PORT=2525
MAIL_TRAP_USER=mailtrap_user
MAIL_TRAP_PASSWORD=mailtrap_password

BLACK_LIST_EMAILS=blocked1@example.com,blocked2@example.com

SMS_HOST=https://sms-api.example.com
SMS_AUTH_KEY=your_sms_api_auth_key_here

KEY_ID=your_aws_kms_key_id_here
SQS_QUEUE_URL=https://sqs.region.amazonaws.com/123456789012/queue-name
